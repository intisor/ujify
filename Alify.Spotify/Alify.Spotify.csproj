<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>spotify-user-secrets</UserSecretsId>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</PublishSingleFile>
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <AssemblyTitle>Ujify</AssemblyTitle>
    <Product>Ujify</Product>
    <AssemblyName>Ujify</AssemblyName>
    <Version>1.5.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpotifyAPI.Web" />
    <PackageReference Include="SpotifyAPI.Web.Auth" />
    <ProjectReference Include="..\Alify.Core\Alify.Core.csproj" />
    <PackageReference Include="TickerQ" />
    <PackageReference Include="TickerQ.Dashboard" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- Embed wwwroot directly into assembly so standalone single-file exe serves CSS/JS anywhere without wwwroot folder -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" Exclude="wwwroot\**\*.map;wwwroot\**\*.rtl.*;wwwroot\**\*LICENSE*" />
  </ItemGroup>

  <!-- Exclude developer source maps and RTL assets from wwwroot publish output -->
  <ItemGroup>
    <Content Update="wwwroot\**\*.map" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\**\*.rtl.*" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
